# White-label settings. Copy to `.env.local` and edit. All values are optional.
# These are baked into the public JavaScript at build time: never put secrets in VITE_ variables.

# Name shown in the header, page titles and Open Graph tags.
VITE_BRAND_NAME="Open Free Tools"

# Absolute or base-relative URL of a square logo (SVG/PNG). Defaults to the built-in mark.
VITE_BRAND_LOGO_URL=

# Accent color (any CSS color). Defaults to lime.
VITE_ACCENT=

# Public URL of your deployment, without a trailing slash, e.g. https://tools.example.com
# Used for canonical links, og:url, hreflang and sitemap.xml. Netlify and Vercel provide it automatically.
VITE_SITE_URL=

# Source-code link in the header and footer. Set to an empty string to hide it.
VITE_REPO_URL=https://github.com/coolhackboy/open-free-tools

# Show the small "Powered by PoYo" footer link. Set to false to hide it.
VITE_SHOW_POWERED_BY=true
